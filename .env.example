# InsightAI environment template. Copy to .env and fill in real values.
# All values are optional except LLM_API_KEY (the app degrades gracefully
# without it, but only returns placeholder text).

# --- LLM (OpenAI-compatible: Groq, OpenAI, local vLLM, etc.) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# --- Web search ---
TAVILY_API_KEY=

# --- STOPGAP login gate (NOT production auth) ---
# Single shared credential for the minimal session gate in core/auth.py.
# Change these before deploying anywhere.
APP_USERNAME=admin
APP_PASSWORD=insightai

# --- Vector store (empty = local embedded Qdrant at QDRANT_LOCAL_PATH) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=./data/qdrant_local
QDRANT_COLLECTION=insightai_docs

# --- Ingestion (single source of truth for chunking) ---
# CHUNK_SIZE=120
# CHUNK_OVERLAP=20

# --- FastAPI backend security (optional; unset = open for local dev) ---
# API_ACCESS_TOKEN=
# API_CORS_ORIGINS=https://your-frontend.example.com

# --- Unused / legacy placeholders (kept for compat) ---
# DATABASE_URL=
# REDIS_URL=